# Copy this file to .env and fill it in. Never commit .env.

# Bot token: Developer Portal → your application → Bot → Reset Token.
DISCORD_TOKEN=your_bot_token_here

# Application ID: Developer Portal → your application → General Information.
CLIENT_ID=your_application_id_here

# Optional. A server ID registers commands in that server only, updated at once:
# use it while developing. Leave it empty to register commands globally.
GUILD_ID=

# development, production or test.
NODE_ENV=development

# true requests the privileged Message Content intent (also enable it in the
# Developer Portal → Bot → Privileged Gateway Intents). Default false.
MESSAGE_CONTENT=false
