{
  "name": "lunibee",
  "version": "0.1.0",
  "description": "A lightweight, Bun-first Discord API library.",
  "type": "module",
  "module": "./packages/lunibee/src/index.ts",
  "types": "./packages/lunibee/src/index.ts",
  "exports": {
    ".": {
      "types": "./packages/lunibee/src/index.ts",
      "import": "./packages/lunibee/src/index.ts"
    }
  },
  "files": [
    "packages"
  ],
  "workspaces": [
    "packages/*",
    "!packages/lunibee"
  ],
  "dependencies": {
    "@lunibee/builders": "file:./packages/builders",
    "@lunibee/collection": "file:./packages/collection",
    "@lunibee/core": "file:./packages/core",
    "@lunibee/formatters": "file:./packages/formatters",
    "@lunibee/managers": "file:./packages/managers",
    "@lunibee/rest": "file:./packages/rest",
    "@lunibee/structures": "file:./packages/structures",
    "@lunibee/types": "file:./packages/types",
    "@lunibee/utils": "file:./packages/utils",
    "@lunibee/voice": "file:./packages/voice",
    "@lunibee/ws": "file:./packages/ws"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT"
}
