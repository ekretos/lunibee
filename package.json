{
  "name": "lunibee-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "A lightweight, Bun-first Discord API ecosystem.",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "format": "bunx --bun prettier --write .",
    "format:check": "bunx --bun prettier --check .",
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
