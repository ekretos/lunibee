{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": false,
    "rootDir": "packages",
    "outDir": ".types",
    "types": [
      "bun"
    ],
    "paths": {
      "@lunibee/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts"
  ]
}
